// ============================================================================
// RUMBO — SCHEMA PRISMA V2
// Modelo: 1 status canónico + 1 currentOwner + 17 sub-status + 5 flags
// ============================================================================
// 
// CAMBIOS vs schema actual:
// - Operation: nuevos campos status canónico, currentOwner, flags, awaitingFor
// - Task: nuevo campo responsibleTeam, actionType, executableAction (JSON)
// - Nuevo modelo: AgentDecision (para tracking de confidence y debugging)
// - EmailDraft, EmailInbound, JourneyStep, TimelineEvent: sin cambios mayores
// 
// MIGRATION STRATEGY:
// Como decidimos arrancar limpio, este schema reemplaza 100% al actual.
// Borrar todas las operations existentes y aplicar este schema fresh.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER / AUTH
// ============================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  fullName  String
  role      String   @default("OPERATIONS")  // OPERATIONS | PRICING | SALES | CUSTOMER_SUPPORT | ADMIN
  team      String   @default("CUSTOMER")    // SALES | PRICING | CUSTOMER | OPS | ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  operations    Operation[]
  tasks         Task[]
  agentDecisions AgentDecision[]
  quotes        Quote[]
  contracts     Contract[]
}

// ============================================================================
// OPERATION — el modelo central
// ============================================================================

model Operation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  // ========== IDENTIFICATION ==========
  operationCode   String   // Código real de operación (post-confirmación)
  quoteCode       String?  // Código interno de cotización (pre-confirmación) si aplica
  containerNumber String?  // Puede ser null si todavía no hay container asignado (cotización)
  
  // ========== STATUS CANÓNICO (5 valores) ==========
  // Macro-estado para reportes y vistas ejecutivas
  status          String   @default("QUOTING")
  // Valores: "QUOTING" | "BOOKING" | "IN_TRANSIT" | "AT_DESTINATION" | "CLOSED"
  
  // ========== SUB-STATUS GRANULAR (17 valores) ==========
  // Lo que el operador ve en el dashboard
  subStatus       String   @default("NEW_QUOTE")
  // Valores: ver 01_ANALISIS_38_STATUS.md catálogo completo
  
  // ========== OWNERSHIP ==========
  currentOwner    String   @default("SALES")
  // Valores: "SALES" | "PRICING" | "CUSTOMER" | "OPS"
  
  // ========== AWAITING (sub-estado dinámico) ==========
  awaitingFor          String?    // qué estamos esperando exactamente
  // Valores: agent_booking_confirmation | client_info | client_docs | 
  //          client_approval_docs | client_etd_confirmation | carrier_documents |
  //          MANI_filing | demurrage_authorization | customs_release | 
  //          delivery_confirmation | null
  awaitingSince        DateTime?  // desde cuándo
  awaitingFollowupDue  DateTime?  // cuándo escalar (default: +48h)
  
  // ========== FLAGS PARALELOS (5) ==========
  isActionRequired     Boolean   @default(false)
  actionRequiredFrom   String?   // SALES | PRICING | CUSTOMER | OPS
  actionRequiredReason String?
  actionRequiredSince  DateTime?
  
  isDelayed            Boolean   @default(false)
  originalETA          DateTime?
  delayReason          String?
  
  isInDispute          Boolean   @default(false)
  disputeReason        String?
  disputeWith          String?   // CARRIER | AGENT | CLIENT | CUSTOMS_BROKER | etc
  
  isQuoteExpired       Boolean   @default(false)
  quoteExpirationDate  DateTime?
  
  isCancelled          Boolean   @default(false)
  cancelReason         String?
  
  // ========== SHIPMENT DETAILS ==========
  originPort           String?
  originCountry        String?   // ISO 2 letras
  destinationPort      String?
  destinationCountry   String?   // ISO 2 letras
  weightKg             Float?
  cbm                  Float?
  incoterm             String?   // FOB | CIF | EXW | DDP
  mode                 String    @default("FCL")  // FCL | LCL | AIR | LAND
  
  // ========== CLIENT ==========
  clientName           String
  clientEmail          String?
  clientReference      String?   // referencia interna del cliente para esta operación
  
  // ========== CARRIER / AGENT ==========
  shippingLine         String?   // Maersk, MSC, etc
  vessel               String?
  bookingNumber        String?
  blNumber             String?
  contractNumber       String?
  originAgentEmail     String?
  
  // ========== TIMELINE ==========
  eta                  DateTime?
  etd                  DateTime?
  actualArrival        DateTime?
  
  // ========== PRICING (sin exponer en dashboard) ==========
  costEstimate         Float?
  costActual           Float?
  
  // ========== METADATA ==========
  priority             String    @default("NORMAL")  // LOW | NORMAL | HIGH | CRITICAL
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  
  // ========== CRITICALITY (para /today feed) ==========
  isCritical           Boolean   @default(false)
  criticalSeverity     String?   // "high" | "medium" | "low"
  criticalHeadline     String?   // frase del título mostrada en el feed
  criticalImpact       String?   // frase del impacto mostrada en el feed
  exposureUsd          Float?    // exposición financiera en USD (penalty, multa, riesgo)
  
  // ========== STAKEHOLDERS (Murchison demo) ==========
  // JSON con array de actores reales de la operación:
  // [{ name, email, company, role, isPrimary }]
  stakeholders         Json?

  // ========== EXTRA FIELDS (Murchison demo, aditivos) ==========
  // Campos opcionales para representar operaciones reales que tienen más detalle
  // del que el schema básico soporta. Aditivos — single-tenant, opt-in.
  finalConsignee       String?   // ej. "Badonel SA" (consignee real vs B/L consignee)
  portOrigin           String?   // ISO ej. "CN-NGB" (complementa originPort que es libre)
  portDestination      String?   // ISO ej. "AR-BUE"
  containerNumbers     String?   // CSV de containers múltiples ej. "FFAU4271913, FX46436623"
  hblNumbers           String?   // CSV de HBL numbers (operaciones pueden tener varios HBL)
  mblNumber            String?   // separado del blNumber existente (que se mantiene compat)
  cartons              Int?      // cantidad de bultos
  cargoDescription     String?
  imoClass             String?   // ej. "9" (li-battery)
  etdOrigin            DateTime?
  etaDestination       DateTime?

  // ========== RELATIONS ==========
  tasks                Task[]
  journeySteps         JourneyStep[]
  timelineEvents       TimelineEvent[]
  emailsInbound        EmailInbound[]
  emailDrafts          EmailDraft[]
  agentDecisions       AgentDecision[]
  attachments          Attachment[]
  suggestedTasks       SuggestedTask[]

  @@index([userId])
  @@index([status])
  @@index([currentOwner])
  @@index([subStatus])
  @@index([isActionRequired])
}

// ============================================================================
// TASK — Action Items que los agentes generan
// ============================================================================

model Task {
  id                String   @id @default(cuid())
  operationId       String
  operation         Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  
  // ========== TASK CONTENT ==========
  title             String
  description       String?
  
  // ========== CLASSIFICATION (nuevo) ==========
  actionType        String   @default("INTERNAL_DECISION")
  // Valores: EMAIL_OUT | DOCUMENT_REQUEST | DOCUMENT_REVIEW | DOCUMENT_GENERATE |
  //          STATUS_CHECK | PAYMENT_ACTION | INTERNAL_DECISION | DATA_ENTRY | ESCALATION
  
  responsibleTeam   String   @default("CUSTOMER")
  // Valores: SALES | PRICING | CUSTOMER | OPS
  
  responsibleParty  String?  // ej: "Lab Biotech SA" | "Maersk" | "Despachante X"
  
  emailIntent       String?  // si actionType = EMAIL_OUT, qué intent
  // Valores: COORDINATION | INFO_REQUEST | INFO_PROVIDE | STATUS_UPDATE |
  //          INSTRUCTION | CONFIRMATION | ESCALATION_INTERNAL | QUOTATION_REQUEST |
  //          QUOTATION_PROVIDE | INVOICE_FOLLOWUP | DISPUTE
  
  // ========== EXECUTABLE ACTION (JSON) ==========
  executableAction  Json?
  // Estructura ejemplo (varía según actionType):
  // EMAIL_OUT: { to, cc, subject, body, attachmentsNeeded, missingInfo[] }
  // DOCUMENT_GENERATE: { documentType, template, dataPoints[] }
  // STATUS_CHECK: { system, identifier, fieldsToVerify[] }
  
  // ========== PRIORITY ==========
  priority          String   @default("NORMAL")
  // Valores: LOW | NORMAL | MEDIUM | HIGH | CRITICAL
  urgency           String   @default("NORMAL")
  // Sinónimo de priority pero específico para urgencia temporal
  
  // ========== STATUS ==========
  status            String   @default("PENDING")
  // Valores: PENDING | IN_PROGRESS | COMPLETED | DISMISSED
  
  // ========== AI METADATA ==========
  createdByAi       Boolean  @default(false)
  aiConfidence      Float?
  aiReasoning       String?
  aiAgent           String?  // qué agente la generó
  
  // ========== TIMESTAMPS ==========
  dueDate           DateTime?
  completedAt       DateTime?
  dismissedAt       DateTime?
  estimatedCost     Float?
  actualCost        Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([operationId])
  @@index([status])
  @@index([responsibleTeam])
  @@index([priority])
}

// ============================================================================
// JOURNEY STEP — Timeline visual de la operación
// ============================================================================

model JourneyStep {
  id            String   @id @default(cuid())
  operationId   String
  operation     Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  
  stepNumber    Int      // orden cronológico
  stepName      String   // nombre del step (ej: "Booking Confirmation")
  description   String?  // narrativa ejecutiva
  
  status        String   @default("PENDING")
  // Valores: PENDING | CURRENT | COMPLETED | SKIPPED
  
  // ========== DATES ==========
  estimatedDate DateTime?
  actualDate    DateTime?
  completedAt   DateTime?
  
  // ========== AI-GENERATED NARRATIVE ==========
  // Cuando el step se completa, el TimelineUpdater puede generar una nota narrativa
  // ej: "Maersk confirmó la reserva en el MAERSK LIMA con salida el 5 de mayo"
  narrativeNote String?
  
  @@index([operationId])
  @@index([stepNumber])
}

// ============================================================================
// TIMELINE EVENT — Eventos puntuales (no son estados, son cosas que pasaron)
// ============================================================================

model TimelineEvent {
  id            String   @id @default(cuid())
  operationId   String
  operation     Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  
  title         String
  description   String?
  eventType     String
  // Valores: EMAIL_RECEIVED | EMAIL_SENT | STATUS_CHANGED | DOCUMENT_RECEIVED |
  //          DOCUMENT_SENT | SCHEDULE_CHANGED | ITINERARY_CHANGED | TASK_COMPLETED |
  //          OPERATION_CREATED | DISPUTE_OPENED | DISPUTE_RESOLVED
  
  source        String   // EMAIL | AI_INTAKE | MANUAL | SYSTEM | TRACKING_API
  sourceTeam    String?  // SALES | PRICING | CUSTOMER | OPS | EXTERNAL
  
  // Para eventos relacionados con cambios
  fromValue     String?  // valor anterior si aplica
  toValue       String?  // valor nuevo si aplica
  
  timestamp     DateTime @default(now())
  
  @@index([operationId])
  @@index([timestamp])
}

// ============================================================================
// EMAIL INBOUND — Emails que entran al sistema
// ============================================================================

model EmailInbound {
  id            String   @id @default(cuid())
  operationId   String?
  operation     Operation? @relation(fields: [operationId], references: [id])
  
  from          String
  to            String
  cc            String?
  subject       String
  body          String   @db.Text
  rawEmail      String?  @db.Text  // email completo si lo guardamos
  
  // ========== ROUTING ==========
  matchConfidence Float?    // qué tan seguros estamos que pertenece a esta operación
  matchedBy       String?   // operationCode | container | bl | thread | sender_match | ai_inference
  
  status        String   @default("PROCESSED")
  // Valores: PENDING_ROUTING | PROCESSED | UNASSIGNED | FAILED
  
  // ========== AI ANALYSIS ==========
  aiAnalysis    Json?    // resultado del orchestrator (qué tipo de email, qué actions generó, etc)
  
  receivedAt    DateTime @default(now())
  processedAt   DateTime?
  
  @@index([operationId])
  @@index([status])
}

// ============================================================================
// EMAIL DRAFT — Drafts generados por AI esperando aprobación
// ============================================================================

model EmailDraft {
  id            String   @id @default(cuid())
  operationId   String
  operation     Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  taskId        String?  // si está vinculado a una task
  
  to            String
  cc            String?
  bcc           String?
  subject       String
  body          String   @db.Text
  attachments   Json?    // array de filenames/IDs
  
  // ========== INTENT ==========
  intent        String?  // COORDINATION | INFO_REQUEST | etc (mismos que en Task)
  recipientType String?  // CARRIER | IMPORTER | EXPORTER | ORIGIN_AGENT | etc
  language      String   @default("es")
  
  // ========== STATUS ==========
  status        String   @default("DRAFT")
  // Valores: DRAFT | EDITED | APPROVED | SENT | REJECTED | FAILED
  
  // ========== AI METADATA ==========
  aiGenerated   Boolean  @default(false)
  aiReasoning   String?
  aiConfidence  Float?
  
  // ========== HUMAN EDIT TRACKING ==========
  // Si el humano edita el draft antes de aprobar, guardamos el delta
  // para usar como few-shot examples futuros
  originalBody  String?  @db.Text  // el body original que generó AI
  finalBody     String?  @db.Text  // el body final después de edits
  
  // ========== MISSING INFO ==========
  missingInfo   Json?    // campos que el draft pide al humano completar antes de enviar
  // ej: [{ field: "to", reason: "destinatario no encontrado en cadena previa" }]
  
  // ========== TIMESTAMPS ==========
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  approvedAt    DateTime?
  sentAt        DateTime?
  rejectedAt    DateTime?
  
  @@index([operationId])
  @@index([status])
}

// ============================================================================
// AGENT DECISION — Tracking de decisiones de los agentes (debugging + learning)
// ============================================================================

model AgentDecision {
  id            String   @id @default(cuid())
  operationId   String?
  operation     Operation? @relation(fields: [operationId], references: [id])
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  
  // ========== DECISION CONTEXT ==========
  agentName     String   // Orchestrator | EmailParser | ActionClassifier | EmailDrafter | TimelineUpdater
  decisionType  String   // CLASSIFY_EMAIL | CREATE_TASK | DRAFT_EMAIL | ADVANCE_STATUS | etc
  
  // ========== INPUT/OUTPUT ==========
  inputData     Json     // qué recibió el agente
  outputData    Json     // qué decidió
  toolsUsed     Json?    // qué tools llamó (si tool use)
  
  // ========== CONFIDENCE ==========
  confidence    Float?
  wasAutoApplied Boolean @default(false)  // si se aplicó solo (>0.9) o requirió aprobación
  
  // ========== HUMAN OVERRIDE ==========
  humanApproved      Boolean?
  humanRejected      Boolean?
  humanModification  Json?     // qué cambió el humano vs lo que el agente sugirió
  
  // ========== METADATA ==========
  modelUsed     String?  // claude-haiku | claude-sonnet-4-6 | claude-opus-4-6
  tokensInput   Int?
  tokensOutput  Int?
  latencyMs     Int?
  
  createdAt     DateTime @default(now())
  
  @@index([operationId])
  @@index([agentName])
  @@index([createdAt])
}

// ============================================================================
// QUOTE — Cotizaciones inbound (pre-Operation)
// ============================================================================
// Una Quote nace cuando un cliente solicita cotización por algún canal
// (email, WhatsApp, formulario web). Pasa por estados de parseo, cotización
// y envío hasta convertirse en Operation o perderse.

model Quote {
  id              String   @id @default(cuid())
  quoteCode       String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  // ========== INTAKE ==========
  clientName      String
  clientEmail     String?
  isNewClient     Boolean  @default(false)
  channel         String
  // Valores: EMAIL | WHATSAPP | WEB_FORM
  originalMessage String   @db.Text
  receivedAt      DateTime

  // ========== STATUS ==========
  status          String   @default("WAITING_FOR_DATA")
  // Valores: WAITING_FOR_DATA | READY_TO_QUOTE | QUOTED_DRAFT | SENT_AWAITING_CLIENT | ACCEPTED | LOST

  // ========== SHIPMENT (parseado, todos opcionales) ==========
  origin              String?
  originCountry       String?   // ISO 2
  destination         String?
  destinationCountry  String?   // ISO 2
  product             String?
  ncmCode             String?
  containerType       String?
  // Valores: FCL_20GP | FCL_40GP | FCL_40HC | FCL_40RF | LCL | AIR
  containerCount      Int?
  weightKg            Float?
  cbm                 Float?
  incoterm            String?
  readyDate           DateTime?
  specialHandling     String?

  // ========== AI PARSING ==========
  aiParsedFields       Json?    // { fieldName: confidence (0..1) }
  aiParsingConfidence  Float?
  missingFields        Json?    // string[] de fields faltantes

  // ========== QUOTE DETAILS (cuando QUOTED_DRAFT en adelante) ==========
  recommendedCarrier   String?
  recommendedReason    String?  @db.Text
  carrierComparison    Json?    // CarrierOption[] — shape en frontend/src/types/quote.ts
  markupPercent        Float    @default(12)
  markupAmount         Float?   // denormalizado (= baseCarrierCost * markupPercent / 100). keep in sync si se edita.
  baseCarrierCost      Float?
  surchargesTotal      Float?
  surchargesBreakdown  Json?    // { name, amount, description? }[]
  quoteFinalUsd        Float?   // denormalizado (= baseCarrierCost + markupAmount + surchargesTotal). keep in sync si se edita.
  quoteValidDays       Int      @default(7)

  // ========== DRAFT REPLY ==========
  draftSubject         String?
  draftBody            String?  @db.Text
  draftAiConfidence    Float?

  // ========== CLIENT HISTORY SNAPSHOT (para sidebar) ==========
  clientHistoryWinRate    Float?
  clientPreferredCarrier  String?
  clientAverageMarkup     Float?

  // ========== TIMESTAMPS ==========
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // ========== RELATIONS ==========
  attachments      Attachment[]

  @@index([userId])
  @@index([status])
  @@index([receivedAt])
}

// ============================================================================
// ATTACHMENT — Documentos asociados a Operations o Quotes
// ============================================================================
// Los archivos físicos viven en public/attachments/<scope>/ y se sirven via
// /static/. Este modelo es solo el metadata para listarlos y mostrar tipos.

model Attachment {
  id            String     @id @default(cuid())
  filename      String     // nombre visible original
  storedPath    String     // ej. "attachments/OP-024-026/HBL_NGBS076774_DRAFT.pdf"
  mimeType      String
  sizeBytes     Int
  documentType  String?    // HBL_DRAFT | MBL_DRAFT | BL_TLX_RELEASE | ARRIVAL_NOTICE | DEBIT_NOTE | GUARANTEE | OTHER
  description   String?
  source        String?    // agent_origin | carrier | customer | destination_agent | forwarder
  receivedAt    DateTime?
  operationId   String?
  quoteId       String?
  operation     Operation? @relation(fields: [operationId], references: [id], onDelete: Cascade)
  quote         Quote?     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())

  @@index([operationId])
  @@index([quoteId])
  @@index([documentType])
}

// ============================================================================
// SUGGESTED TASK — Acciones que los agentes sugieren para una operación
// ============================================================================
// Diferente de Task (deuda task histórica), SuggestedTask vive en el panel
// "Tareas sugeridas" de /operations/[id]. Cada una tiene priority + type
// (agent que la generó) + opcionalmente un draft completo (subject + to +
// cc + body) + opcionalmente attachments adjuntos al draft.

model SuggestedTask {
  id                String    @id @default(cuid())
  operationId       String
  operation         Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  // ===== CLASSIFICATION =====
  type              String    // REPLY | QUOTE | WATCH | CLEAR | READ | RANK | GROWTH
  priority          String    // urgent | high | medium | low
  agentSource       String?   // alias del type para tracking (REPLY/QUOTE/etc.)
  isInformational   Boolean   @default(false)

  // ===== CONTENT =====
  title             String
  description       String?   @db.Text

  // ===== DRAFT (opcional) =====
  draftSubject      String?
  draftTo           String?
  draftCc           String?
  draftBody         String?   @db.Text

  // ===== ACTION CTA (cuando no hay draft) =====
  actionLabel       String?

  // ===== AI METADATA =====
  confidence        Int?

  // ===== ATTACHMENTS adjuntos al draft =====
  attachmentIds     String[]

  // ===== STATUS =====
  status            String    @default("pending")  // pending | approved | dismissed

  // ===== TIMESTAMPS =====
  sortOrder         Int       @default(0)  // para mantener orden estable dentro de una op
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([operationId])
  @@index([operationId, status])
  @@index([priority])
}

// ============================================================================
// CONTRACT — Contratos con carriers (rates negociados + volumen committed)
// ============================================================================
model Contract {
  id                 String   @id @default(cuid())
  contractNumber     String   @unique
  userId             String
  user               User     @relation(fields: [userId], references: [id])

  carrier            String
  lane               String
  originPort         String
  destinationPort    String
  containerType      String
  // Valores: FCL_20GP | FCL_40GP | FCL_40HC | FCL_40RF | LCL | AIR

  rateUsd            Float
  volumeCommittedTeu Int
  volumeUsedTeu      Int      @default(0)

  validFrom          DateTime
  validUntil         DateTime

  status             String   @default("ACTIVE")
  // Valores: ACTIVE | EXPIRING_SOON | UNDERUTILIZED | EXPIRED

  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([carrier])
}
